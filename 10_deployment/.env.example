# PathSnap Two-Laptop Configuration Template (Model 4: NN-GLS + RLCD)
# Copy to .env on Laptop 1 and adjust paths as needed. NEVER commit real credentials.

# Directory containing the 10 evaluation trips on Laptop 1.
# During development: points to ../Student folder/student_test
# During final evaluation: set to the folder containing the 10 reserved evaluator_test trips
PATHSNAP_EVAL_DIR=../Student folder/student_test

# Host and port for Laptop 1 FastAPI server
PATHSNAP_API_HOST=0.0.0.0
PATHSNAP_API_PORT=8000

# Laptop 2 UI port
PATHSNAP_UI_PORT=3000
